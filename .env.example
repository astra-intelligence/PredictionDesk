# Copy to .env and fill in. .env is gitignored — never commit secrets.
# PAPER TRADING + BACKTESTING NEED NONE OF THESE. Only the live/real-money
# executor (P4, gated behind an evaluator PASS) reads them.

# ── Polymarket live execution (P4 only) ──────────────────────────────────────
POLY_PRIVATE_KEY=            # EOA private key that signs orders. KEEP SECRET.
POLY_FUNDER_ADDRESS=         # Polymarket account (proxy) address holding pUSD, 0x…
POLY_API_KEY=                # CLOB creds — derive once via client.create_or_derive_api_creds()
POLY_API_SECRET=
POLY_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137                 # Polygon mainnet
SIGNATURE_TYPE=1             # 1 = Polymarket proxy wallet, 0 = plain EOA

# ── Real-money safety caps (P4) ──────────────────────────────────────────────
LIVE_TRADING_ENABLED=false   # master switch; stays false until evaluator PASS
MAX_ORDER_USD=5
# MAX_DAILY_USD=50   # ENFORCED by the live executor: worst-case $ newly committed per UTC day,
#                      metered in a persisted flock'd ledger (driver/daily_spend.json under
#                      DESK_DATA_DIR). Unset/none/off = no daily cap. Fail-closed: malformed value
#                      or unreadable ledger refuses orders; reduce-only exits are exempt.

# ── Display timezone (dashboard + reports) ───────────────────────────────────
# DESK_TZ=UTC        # IANA name (e.g. Europe/London). Timestamps RENDER in this tz; storage stays unix/UTC.

# ── Data-capture LLM monitor (optional) ──────────────────────────────────────
# Only the hourly capture_monitor.py uses this. Without it the monitor still runs,
# but falls back to a rule-based verdict (no LLM reasoning). capture_monitor.py reads
# the key from .env (or ~/.anthropic_key) so the service-manager job — which doesn't
# inherit your shell env — can reach it. Capture/backtest/paper trading need none of these.
ANTHROPIC_API_KEY=           # sk-ant-… for the hourly data-quality monitor (Haiku)

# Taker-fee enforcement knob: true (default) = charge documented per-category rates in sim;
# false = align sim fees to observed-live zero (exchange currently not enforcing taker fees).
DESK_TAKER_FEES_ENABLED=true

# Live/forward daemons should bound book reads (backtests/recon leave unset = unbounded):
# DESK_BOOK_MAX_FILES=40
