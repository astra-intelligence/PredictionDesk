<?xml version="1.0" encoding="UTF-8"?>
<!-- Hourly LLM-judge monitor. Install:
       cp scripts/com.desk.capturemonitor.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.desk.capturemonitor.plist
     Needs ANTHROPIC_API_KEY in your shell profile (bash -lc sources it); else runs rule-based.
     Reports -> desk/data/capture/capture_monitor.log + _monitor.json -->
<!-- PATH PLACEHOLDER: launchd needs absolute paths — before installing, point every
     /Users/YOUR_USERNAME/desk-repo at your checkout:
       sed -i "" "s#/Users/YOUR_USERNAME/desk-repo#$PWD#g" scripts/com.desk.*.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.desk.capturemonitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "/Users/YOUR_USERNAME/desk-repo" &amp;&amp; exec python3 -m desk.data.capture_monitor desk/capture_config.json</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>WorkingDirectory</key><string>/Users/YOUR_USERNAME/desk-repo</string>
  <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/desk-repo/desk/data/capture/capturemonitor.out</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/desk-repo/desk/data/capture/capturemonitor.err</string>
</dict>
</plist>
